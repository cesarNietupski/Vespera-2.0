[
  {
    "npc": "salvia",
    "text": "O mundo aprendeu a viver sem o sol. Ainda não aprendeu a viver sem lembranças.",
    "file": "voices/salvia-3538453d4c160c27.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "Você era nossa cartógrafa. Agora carrega a única centelha capaz de alcançar o Tear.",
    "file": "voices/salvia-feff26366655d914.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "Atravesse o portão. E, se a escuridão vencer, encontre o caminho de volta.",
    "file": "voices/salvia-f683656c322119f3.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "Eu guardei uma lembrança sua. Uma que o Tear nunca deveria ter consumido.",
    "file": "voices/salvia-46c94ad05d51b245.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "A aurora não precisa ser alimentada por esquecimentos. Você pode mudar o que construiu.",
    "file": "voices/salvia-f9cf18ea4f49f206.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "O Farol a trouxe de volta 1 vez. Cada retorno deixa uma marca que só eu consigo ver.",
    "file": "voices/salvia-560e27f9bea4b2f8.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
  {
    "npc": "salvia",
    "text": "Você não nasceu com essa luz, Eira. Estava lá quando o Tear se partiu. Procure as memórias dos Vigias.",
    "file": "voices/salvia-7561786f89d5e202.wav",
    "voice": "Microsoft Maria Desktop - Portuguese(Brazil)",
    "pitch": 0.84,
    "rate": 0.88,
    "style": "Serena e acolhedora"
  },
